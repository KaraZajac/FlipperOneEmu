"""FlipperOneEmu: the Flipper One in QEMU: its MCU (the RP2350) and its CPU
(the RK3576).

    ./flipperoneemu run [-n NAME] [--uf2 FILE] [--detach] [--gdb PORT]
    ./flipperoneemu run --linux [BUILD] ...  Flipper OS's kernel on the RK3576
                                         (scripts/fetch_os.py fetches a build)
    ./flipperoneemu gui [-n NAME] [--linux]  the window; it starts the device too
    ./flipperoneemu stop [-n NAME]
    ./flipperoneemu status [-n NAME]
    ./flipperoneemu log [-n NAME]        the firmware's log, from its RTT buffer
    ./flipperoneemu shot FILE.png [-n NAME] [--zoom N]
    ./flipperoneemu where [-n NAME]      each core's PC, and the function there
    ./flipperoneemu cli [-n NAME] [COMMAND...]   the MCU firmware's CLI (UART1)
    ./flipperoneemu console [-n NAME] [--uart4|--usb]  Linux's console (the
                                         RK3576's UART0: the debug port; UART4:
                                         the MCU's; --usb: its USB gadget's)

A device is a folder, devices/NAME (default "one"): the MCU's flash image
(flash.bin, made from a recovery .uf2 the first time, and written to as the
firmware writes its flash), the sockets of its front panel and monitor, QEMU's
log. Run scripts/setup_qemu.sh and scripts/fetch_firmware.py first.
"""
import argparse
import base64
import glob
import json
import os
import pathlib
import signal
import socket
import struct
import subprocess
import sys
import time
import zlib

ROOT = pathlib.Path(__file__).resolve().parent
QEMU = ROOT / "build" / "qemu" / "qemu-system-aarch64"
BOOTROM = ROOT / "firmware" / "bootrom" / "A4" / "bootrom-combined.bin"
OS_DIR = ROOT / "firmware" / "os"
SCRIPTS = ROOT / "scripts"


def die(msg):
    print(f"flipperoneemu: {msg}", file=sys.stderr)
    sys.exit(1)


def device_dir(name):
    return ROOT / "devices" / name


def pid_of(d):
    try:
        pid = int((d / "qemu.pid").read_text())
        os.kill(pid, 0)
        return pid
    except (OSError, ValueError):
        return None


def newest(pattern):
    found = sorted(glob.glob(str(ROOT / pattern)), key=os.path.getmtime)
    return pathlib.Path(found[-1]) if found else None


def make_flash(d, uf2):
    """flash.bin from a recovery .uf2, and the firmware's ELF beside it"""
    if not uf2:
        uf2 = newest("firmware/mcu/*/flipper-one-mcu-f1-recovery-*.uf2")
        if not uf2:
            die("no MCU firmware: run scripts/fetch_firmware.py, or give --uf2")
    uf2 = pathlib.Path(uf2).resolve()
    r = subprocess.run([sys.executable, str(SCRIPTS / "uf2.py"),
                        str(d / "flash.bin"), str(uf2)])
    if r.returncode:
        die(f"could not make a flash image from {uf2}")
    elf = pathlib.Path(str(uf2).replace("-recovery-", "-firmware-")).with_suffix(".elf")
    (d / "firmware.json").write_text(json.dumps({
        "uf2": str(uf2), "elf": str(elf) if elf.exists() else None,
        "made": time.strftime("%Y-%m-%d %H:%M:%S")}, indent=1) + "\n")


def cmd_run(args):
    d = device_dir(args.name)
    if not QEMU.exists():
        die(f"no {QEMU.relative_to(ROOT)}: run scripts/setup_qemu.sh")
    if not BOOTROM.exists():
        die("no RP2350 boot ROM: run scripts/fetch_firmware.py")
    if pid_of(d):
        die(f"{args.name} is running already (pid {pid_of(d)})")
    d.mkdir(parents=True, exist_ok=True)
    if args.uf2 or not (d / "flash.bin").exists():
        make_flash(d, args.uf2)
    for sock in ("panel.sock", "monitor.sock", "cli.sock", "host.sock",
                 "usb.sock", "linux.sock", "linux4.sock"):
        (d / sock).unlink(missing_ok=True)
    machine = f"flipper-one,flash={d / 'flash.bin'},log=mculog"
    if args.bootsel:
        machine += ",bootsel=on"
    if getattr(args, "hdmi", False):            # a monitor from the start
        machine += ",hdmi=on"
    cmd = [str(QEMU), "-M", machine,
           "-chardev", f"file,id=mculog,path={d / 'mcu.log'}",
           "-bios", str(BOOTROM), "-display", "none",
           "-chardev", f"socket,id=cli,path={d / 'cli.sock'},server=on,wait=off",
           "-serial", "chardev:cli",
           "-serial", "null",                   # (the RP2350's UART0)
           # the RK3576's UART0 (the debug port) and UART4 (to the MCU)
           "-chardev", f"socket,id=linux,path={d / 'linux.sock'},server=on,wait=off,"
                       f"logfile={d / 'linux.log'},logappend=off",
           "-serial", "chardev:linux",
           "-chardev", f"socket,id=linux4,path={d / 'linux4.sock'},server=on,wait=off",
           "-serial", "chardev:linux4",
           "-monitor", f"unix:{d / 'monitor.sock'},server=on,wait=off",
           "-chardev", f"socket,id=panel,path={d / 'panel.sock'},server=on,wait=off",
           "-global", "flipper-one-panel.link=panel",
           "-chardev", f"socket,id=host,path={d / 'host.sock'},server=on,wait=off",
           "-chardev", f"socket,id=usbcdc,path={d / 'usb.sock'},server=on,wait=off",
           "-global", "flipper-one-usb-host.cdc=usbcdc",
           "-global", "flipper-one-host.link=host",
           "-name", f"flipperone-{args.name}",
           "-d", "guest_errors", "-D", str(d / "qemu.log")]
    if getattr(args, "uboot", False):
        if args.linux is None:
            die("--uboot: with --linux")
        if args.kernel_args:
            die("--uboot: the boot entry's options are U-Boot's to give; "
                "no --kernel-args")
    if args.linux is not None:
        cmd += linux_args(d, args.linux, args.kernel_args,
                          getattr(args, "uboot", False))
    if args.gdb:
        cmd += ["-gdb", f"tcp::{args.gdb}"]
    if args.net or args.ssh:
        # the RK3576's first Ethernet port on this PC's network, through
        # passt (QEMU starts it): NAT, DHCP and DNS, no root needed; and
        # this PC's port (on its loopback only) to the device's SSH
        cmd += ["-nic", "passt" + (f",tcp-ports=127.0.0.1/{args.ssh}:22"
                                   if args.ssh else "")]
    if args.usbip:
        cmd += ["-chardev", f"socket,id=usbip,host=127.0.0.1,port={args.usbip},"
                "server=on,wait=off",
                "-global", "flipper-one-usb-host.usbip=usbip"]
    # the audio codec's sound (Flipper OS plays at 48 kHz): nowhere, a WAV
    # file, or this PC's sound through a driver QEMU was built with
    audio = (f"wav,path={os.path.abspath(args.audio)}"
             if args.audio.endswith(".wav") else args.audio)
    cmd += ["-audiodev", f"{audio},id=snd0,out.frequency=48000",
            "-global", "nau8822.audiodev=snd0"]
    # the HDMI port's picture (QEMU's first graphic console), live, to a VNC
    # viewer on this PC: its loopback only
    if getattr(args, "vnc", None):
        if not 5900 <= args.vnc <= 65535:
            die("--vnc: a port from 5900 on")
        if not (QEMU.parent / "pc-bios" / "keymaps" / "en-us").exists():
            die("--vnc: QEMU's keymap is not built: scripts/setup_qemu.sh")
        cmd += ["-vnc", f"127.0.0.1:{args.vnc - 5900}"]
    # what the codec's internal microphone hears: a WAV file, looped
    if getattr(args, "mic", None):
        if not os.path.isfile(args.mic):
            die(f"{args.mic}: no such file")
        cmd += ["-global", f"nau8822.mic={os.path.abspath(args.mic)}"]
    # an NVMe SSD in the M.2 slot (PCIe0's root port, bus dw-pcie): its disk
    # a raw image, the device's own nvme.img unless told (a blank 256 GB,
    # sparse, the first time)
    if getattr(args, "nvme", None) is not None:
        img = pathlib.Path(args.nvme or d / "nvme.img").absolute()
        if not img.exists():
            with open(img, "wb"):
                pass
            os.truncate(img, 256 * 10**9)
        cmd += ["-drive", f"if=none,id=nvme0,format=raw,file={img}",
                "-device", "nvme,drive=nvme0,serial=FlipperOneEmu-M2,"
                "bus=dw-pcie"]
    if args.detach:
        with open(d / "qemu.out", "wb") as out:
            p = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=out,
                                 stderr=subprocess.STDOUT, start_new_session=True)
        (d / "qemu.pid").write_text(f"{p.pid}\n")
        for _ in range(50):                     # its sockets, before we go
            if (d / "panel.sock").exists() or p.poll() is not None:
                break
            time.sleep(0.1)
        if p.poll() is not None:
            die(f"QEMU ended at once: see {d / 'qemu.out'}")
        print(f"{args.name}: running (pid {p.pid})")
        return 0
    p = subprocess.Popen(cmd, stdin=subprocess.DEVNULL)
    (d / "qemu.pid").write_text(f"{p.pid}\n")
    try:
        return p.wait()
    except KeyboardInterrupt:
        p.send_signal(signal.SIGTERM)
        return p.wait()


def monitor(d, line):
    """a monitor command's answer: what comes up to the next prompt"""
    s = socket.socket(socket.AF_UNIX)
    s.settimeout(3)
    s.connect(str(d / "monitor.sock"))

    def until_prompt():
        out = b""
        try:
            while not out.rstrip().endswith(b"(qemu)"):
                chunk = s.recv(65536)
                if not chunk:
                    break
                out += chunk
        except socket.timeout:
            pass
        return out.decode("latin1")
    try:
        until_prompt()
        s.sendall(line.encode() + b"\n")
        return until_prompt()
    finally:
        s.close()


def cmd_stop(args):
    d = device_dir(args.name)
    pid = pid_of(d)
    if not pid:
        print(f"{args.name}: not running")
        return 0
    try:
        monitor(d, "quit")
    except OSError:
        os.kill(pid, signal.SIGTERM)
    for _ in range(50):
        if not pid_of(d):
            break
        time.sleep(0.1)
    else:
        os.kill(pid, signal.SIGKILL)
    print(f"{args.name}: stopped")
    return 0


def cmd_status(args):
    d = device_dir(args.name)
    if not d.exists():
        print(f"{args.name}: no such device (devices/{args.name})")
        return 1
    pid = pid_of(d)
    print(f"{args.name}: {'running, pid %d' % pid if pid else 'not running'}")
    fw = d / "firmware.json"
    if fw.exists():
        info = json.loads(fw.read_text())
        print(f"  firmware: {pathlib.Path(info['uf2']).name}")
    return 0


def cmd_gui(args):
    return subprocess.call([sys.executable, str(SCRIPTS / "fo_gui.py"), "-n",
                            args.name] + (["--zoom", str(args.zoom)]
                                          if args.zoom else []) +
                           (["--linux"] if args.linux else []))


def cmd_log(args):
    d = device_dir(args.name)
    if not pid_of(d):
        die(f"{args.name} is not running")
    info = json.loads((d / "firmware.json").read_text())
    if not info.get("elf"):
        die("the firmware's ELF is not known (firmware.json)")
    return subprocess.call([sys.executable, str(SCRIPTS / "rtt.py"),
                            str(d / "monitor.sock"), info["elf"]])


def elf_functions(path):
    """[(start, end, name)] of an ELF's functions"""
    data = open(path, "rb").read()
    shoff, = struct.unpack_from("<I", data, 0x20)
    shentsize, shnum = struct.unpack_from("<HH", data, 0x2e)
    sections = [struct.unpack_from("<IIIIIIIIII", data, shoff + i * shentsize)
                for i in range(shnum)]
    funcs = []
    for sh in sections:
        if sh[1] != 2:                              # SHT_SYMTAB
            continue
        strtab = sections[sh[6]]
        for off in range(sh[4], sh[4] + sh[5], 16):
            st_name, value, size, info = struct.unpack_from("<IIIB", data, off)
            if info & 0xf == 2 and size:            # STT_FUNC
                end = data.index(b"\0", strtab[4] + st_name)
                name = data[strtab[4] + st_name:end].decode()
                funcs.append((value & ~1, (value & ~1) + size, name))
    return sorted(funcs)


def cmd_where(args):
    """where each core is: its PC, and the function there"""
    d = device_dir(args.name)
    if not pid_of(d):
        die(f"{args.name} is not running")
    text = monitor(d, "info registers -a")
    info = json.loads((d / "firmware.json").read_text())
    elfs = [p for p in (info.get("elf"),
                        str(ROOT / "firmware/bootrom/A4/arm-bootrom.elf")) if p]
    funcs = [f for p in elfs if os.path.exists(p) for f in elf_functions(p)]
    import re
    cpus = re.split(r"CPU#(\d+)", text)[1:]
    for cpu, regs in zip(cpus[::2], cpus[1::2]):
        if not re.search(r"R15=", regs):        # the RK3576's (AArch64)
            pc = re.search(r"\bPC=([0-9a-f]+)", regs)
            lr = re.search(r"\bX30=([0-9a-f]+)", regs)
            print(f"core {cpu}: pc {pc.group(1) if pc else '?'}  lr "
                  f"{lr.group(1) if lr else '?'}  (the RK3576's)")
            continue
        pc = int(re.search(r"R15=([0-9a-f]+)", regs).group(1), 16)
        lr = int(re.search(r"R14=([0-9a-f]+)", regs).group(1), 16)
        name = lambda a: next((f"{n}+{a - s:#x}" for s, e, n in funcs
                               if s <= (a & ~1) < e), "?")
        print(f"core {cpu}: pc {pc:08x} {name(pc)}  lr {lr:08x} {name(lr)}")
    return 0


def cmd_console(args):
    """Linux's console: the RK3576's UART0 (or UART4), or Flipper OS's serial
    port on its USB gadget"""
    if args.usb:
        return terminal(args, "usb.sock", "Flipper OS's serial port on its "
                        "USB gadget (a computer plugged in)", "\n")
    return terminal(args, "linux4.sock" if args.uart4 else "linux.sock",
                    "the RK3576's " + ("UART4" if args.uart4 else "UART0") +
                    ", Linux's console", "\n")


def cmd_cli(args):
    """the MCU firmware's CLI (UART1): a command, or a terminal"""
    return terminal(args, "usb.sock" if args.usb else "cli.sock",
                    "the MCU's CLI", "\r")


def terminal(args, sock, what, enter):
    """a command and its answer, or a terminal, on one of a device's serial
    ports; @enter: what ends a line there"""
    d = device_dir(args.name)
    s = socket.socket(socket.AF_UNIX)
    try:
        s.connect(str(d / sock))
    except OSError:
        die(f"{args.name} is not running")
    if args.command:
        s.sendall((" ".join(args.command) + enter).encode())
        s.settimeout(args.wait)
        out = b""
        try:
            while True:
                chunk = s.recv(65536)
                if not chunk:
                    break
                out += chunk
        except socket.timeout:
            pass
        sys.stdout.write(out.decode("utf-8", "replace"))
        return 0
    import selectors
    import termios
    import tty
    sel = selectors.DefaultSelector()
    sel.register(s, selectors.EVENT_READ)
    sel.register(sys.stdin, selectors.EVENT_READ)
    old = termios.tcgetattr(sys.stdin) if sys.stdin.isatty() else None
    if old:
        tty.setraw(sys.stdin)
    print(f"({what}; Ctrl-] to leave)\r")
    try:
        while True:
            for key, _ in sel.select():
                if key.fileobj is s:
                    data = s.recv(65536)
                    if not data:
                        return 0
                    os.write(1, data)
                else:
                    data = os.read(0, 1024)
                    if not data or b"\x1d" in data:
                        return 0
                    s.sendall(data.replace(b"\n", enter.encode()))
    finally:
        if old:
            termios.tcsetattr(sys.stdin, termios.TCSADRAIN, old)


def linux_args(d, build, more="", uboot=False):
    """QEMU's arguments for Flipper OS's kernel on the RK3576: a build's (the
    newest fetched unless told), with the device tree of the board revision
    the MCU firmware is for, and its boot entry's options; the debug port's
    UART0 is the console last named, the one the initramfs's shell uses. Or,
    with uboot, U-Boot from the device's microSD card, as on the device: it
    shows its boot menu on the Flipper's screen and boots what is picked"""
    builds = sorted((p for p in OS_DIR.glob("*/os.json")),
                    key=lambda p: int(p.parent.name) if p.parent.name.isdigit()
                    else -1)
    if build:
        builds = [p for p in builds if p.parent.name == build]
    if not builds:
        die("no Flipper OS build: run scripts/fetch_os.py")
    info = json.loads(builds[-1].read_text())
    target = "f1"
    try:
        uf2 = json.loads((d / "firmware.json").read_text())["uf2"]
        target = "f2" if "-f2-" in pathlib.Path(uf2).name else "f1"
    except (OSError, ValueError, KeyError):
        pass
    rev = {"f1": "rev-f0b0c1", "f2": "rev-f0b1c2"}[target]
    dtb = ROOT / info["dtbs"] / "rockchip" / f"rk3576-flipper-one-{rev}.dtb"
    if not uboot and not dtb.exists():
        die(f"no {dtb.relative_to(ROOT)}")
    # its microSD card: the build's image, the first time (QEMU's SD cards
    # are a power of 2 in size: 8 GiB, sparse); the device's from then on
    card = d / "sd.img"
    if not card.exists():
        zst = OS_DIR / str(info["build"]) / \
            f"debian-512-flipper-one-{info['build']}.img.zst"
        if not zst.exists():
            die(f"no {zst.relative_to(ROOT)}: run scripts/fetch_os.py")
        print(f"{d.name}: its microSD card, from build {info['build']}")
        subprocess.run(["zstd", "-q", "-d", "--sparse", "-o", str(card),
                        str(zst)], check=True)
        os.truncate(card, 8 << 30)
    # its UFS, the Flipper One's own 64 GB: blank (sparse) the first time,
    # as one that nothing was installed on; the device's from then on
    ufs = d / "ufs.img"
    if not ufs.exists():
        with open(ufs, "wb"):
            pass
        os.truncate(ufs, 64 * 10**9)
    disks = ["-drive", f"if=sd,format=raw,file={card}",
             "-drive", f"if=none,id=ufs,format=raw,file={ufs}"]
    if uboot:                   # (SPL's, TF-A's and the DDR blob's parts:
        return ["-machine", f"uboot=on,rev={rev[4:]}"] + disks  # the machine)
    return ["-kernel", str(ROOT / info["kernel"]), "-dtb", str(dtb),
            "-initrd", str(ROOT / info["initrd"]),
            # rw: the boot entries leave it out (Debian's initramfs then
            # mounts the root read-only), and a first boot writes
            # /etc/machine-id. The performance governor: the emulated
            # cores run as fast as the host lets them, whatever their
            # clock, and schedutil's changes of it (an SMC to the SCMI
            # server, a write to the PMIC over I2C, dozens a second) made
            # Flipper OS a third slower for nothing. Devices 5 min, not
            # systemd's 90 s, to show up: on a busy PC udev's coldplug of
            # the emulated board took longer, the partitions' by-uuid links
            # came late, and the boot went to emergency mode
            "-append", info["options"] + " rw console=ttyS0,1500000n8"
            " cpufreq.default_governor=performance"
            " systemd.default_device_timeout_sec=300" +
            (f" {more}" if more else "")] + disks


def png(path, width, height, rgb):
    raw = b"".join(b"\0" + rgb[y * width * 3:(y + 1) * width * 3]
                   for y in range(height))

    def chunk(kind, data):
        c = struct.pack(">I", len(data)) + kind + data
        return c + struct.pack(">I", zlib.crc32(kind + data) & 0xffffffff)
    with open(path, "wb") as f:
        f.write(b"\x89PNG\r\n\x1a\n")
        f.write(chunk(b"IHDR", struct.pack(">IIBBBBB", width, height, 8, 2, 0, 0, 0)))
        f.write(chunk(b"IDAT", zlib.compress(raw, 9)))
        f.write(chunk(b"IEND", b""))


def cmd_shot(args):
    """the screen as the panel shows it, in its colours; or with --hdmi,
    what the HDMI port gives the monitor (QEMU's console, as it dumps it)"""
    d = device_dir(args.name)
    if args.hdmi:
        path = os.path.abspath(args.file)
        try:
            pathlib.Path(path).unlink(missing_ok=True)
            monitor(d, f"screendump {path} -f png")
        except OSError:
            die(f"{args.name} is not running")
        if not os.path.exists(path):
            die("no picture from the HDMI port")
        print(f"{args.file}: the HDMI port's picture")
        return 0
    s = socket.socket(socket.AF_UNIX)
    s.settimeout(2)
    try:
        s.connect(str(d / "panel.sock"))
    except OSError:
        die(f"{args.name} is not running")
    s.sendall(b"hello flipperoneemu shot\n")
    pixels, lcd_on, backlight, buf, got = bytearray(256 * 144), False, 0, b"", 0
    deadline = time.time() + 3
    while time.time() < deadline and got < 144:
        try:
            chunk = s.recv(1 << 16)
        except socket.timeout:
            break
        if not chunk:
            break
        buf += chunk
        while b"\n" in buf:
            line, buf = buf.split(b"\n", 1)
            word, _, rest = line.decode("ascii", "replace").partition(" ")
            if word == "rows":
                y, n, data = rest.split(" ", 2)
                y, n = int(y), int(n)
                pixels[y * 256:(y + n) * 256] = base64.b64decode(data)
                got += n
            elif word == "lcd":
                lcd_on = rest.strip() == "on"
            elif word == "backlight":
                backlight = int(rest)
    s.close()
    if got < 144:
        die("no picture from the panel (another program has it?)")
    # the window's colours (scripts/fo_body.py, lcd_colours()), without Qt:
    # dark and light, unlit and lit, mixed by how lit the backlight looks
    y = max(0, min(255, backlight)) / 255
    t = (116 * y ** (1 / 3) - 16) / 100 if y > 0.008856 else 9.033 * y
    ink = [a + (b - a) * t for a, b in zip((0x1a, 0x0d, 0x04), (0x52, 0x1f, 0x02))]
    paper = [a + (b - a) * t for a, b in zip((0x3b, 0x28, 0x18), (0xf7, 0x99, 0x4c))]
    lut = [bytes(round(ink[i] + (paper[i] - ink[i]) * v / 255) for i in range(3))
           for v in range(256)]
    z = max(1, args.zoom or 3)
    rgb = bytearray()
    for y in range(144):
        row = b"".join(lut[pixels[y * 256 + x] if lcd_on else 255] * z
                       for x in range(256))
        rgb += row * z
    png(args.file, 256 * z, 144 * z, bytes(rgb))
    print(f"{args.file}: the screen{'' if lcd_on else ' (off)'}, {256 * z}x{144 * z}")
    return 0


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0],
                                 formatter_class=argparse.RawDescriptionHelpFormatter,
                                 epilog=__doc__.split("\n\n", 1)[1])
    sub = ap.add_subparsers(dest="cmd", required=True)
    for name in ("run", "gui", "stop", "status", "log", "shot", "where", "cli",
                 "console"):
        p = sub.add_parser(name)
        p.add_argument("-n", "--name", default="one", help="the device (devices/NAME)")
        if name == "run":
            p.add_argument("--uf2", help="make the flash anew from this recovery .uf2")
            p.add_argument("--detach", action="store_true", help="run in the background")
            p.add_argument("--gdb", type=int, metavar="PORT", help="QEMU's gdb stub")
            p.add_argument("--usbip", type=int, metavar="PORT",
                           help="give the MCU's USB device to this PC over "
                                "USB/IP on this TCP port (3240 is usbip's)")
            p.add_argument("--bootsel", action="store_true",
                           help="start with BOOTSEL held: the boot ROM's USB "
                                "boot (its drive and PICOBOOT)")
            p.add_argument("--linux", nargs="?", const="", metavar="BUILD",
                           help="start Flipper OS's kernel on the RK3576 (a "
                                "build fetched by scripts/fetch_os.py; the "
                                "newest unless told)")
            p.add_argument("--uboot", action="store_true",
                           help="... through U-Boot, from the microSD card, as "
                                "on the device: its boot menu on the Flipper's "
                                "screen (up, down, OK), the boot entry's own "
                                "options (the machine plays SPL and TF-A)")
            p.add_argument("--net", action="store_true",
                           help="a cable in the first Ethernet port, to this "
                                "PC's network (through passt)")
            p.add_argument("--ssh", type=int, metavar="PORT",
                           help="... and this PC's PORT to Flipper OS's SSH "
                                "(port 22): ssh -p PORT user@127.0.0.1")
            p.add_argument("--kernel-args", metavar="ARGS", default="",
                           help="more of the kernel's command line, after "
                                "the boot entry's")
            p.add_argument("--audio", metavar="WHERE", default="none",
                           help="where the audio codec's sound goes: none "
                                "(the default), FILE.wav, or an audio driver "
                                "this QEMU has (qemu-system-aarch64 "
                                "-audiodev help)")
            p.add_argument("--mic", metavar="FILE.wav",
                           help="what the board's internal microphone hears: "
                                "a WAV file (16-bit PCM), looped; silence "
                                "without one")
            p.add_argument("--nvme", metavar="FILE.img", nargs="?", const="",
                           help="an NVMe SSD in the M.2 slot, its disk a raw "
                                "image (default devices/NAME/nvme.img: a "
                                "blank 256 GB the first time)")
            p.add_argument("--hdmi", action="store_true",
                           help="a monitor in the HDMI port from the start "
                                "(1280x720 preferred; `shot --hdmi` takes "
                                "its picture; the panel link's `hdmi 1|0` "
                                "plugs one in and out)")
            p.add_argument("--vnc", type=int, metavar="PORT",
                           help="... and what it shows, live, to a VNC "
                                "viewer at 127.0.0.1:PORT (5900 on)")
        if name in ("gui", "shot"):
            p.add_argument("--zoom", type=int)
        if name == "gui":
            p.add_argument("--linux", action="store_true",
                           help="start Flipper OS on the RK3576 too")
        if name == "shot":
            p.add_argument("file")
            p.add_argument("--hdmi", action="store_true",
                           help="the HDMI port's picture, not the screen's")
        if name in ("cli", "console"):
            p.add_argument("command", nargs="*", help="one command, then quit")
            p.add_argument("--wait", type=float, default=1.5,
                           help="seconds of quiet that end a command's answer")
        if name == "cli":
            p.add_argument("--usb", action="store_true",
                           help="the CLI on the MCU's USB serial port (a "
                                "computer plugged in), not its UART")
        if name == "console":
            p.add_argument("--uart4", action="store_true",
                           help="UART4, the line to the MCU, not UART0")
            p.add_argument("--usb", action="store_true",
                           help="Flipper OS's serial port on its USB gadget "
                                "(a computer plugged in), not UART0")
    args = ap.parse_args()
    return globals()["cmd_" + args.cmd](args)


if __name__ == "__main__":
    sys.exit(main())
