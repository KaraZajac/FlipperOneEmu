+/*
+ * The LU's drive at @bytes: what was on it gone when @erase (a device
+ * provisioned again rebuilds its mapping), else only grown or cut to it
+ */
+static bool ufs_lu_resize(UfsLu *lu, uint64_t bytes, bool erase, Error **errp)
+{
+    BlockBackend *blk = lu->scsi_dev ? lu->scsi_dev->conf.blk : lu->conf.blk;
+    BlockDriverState *bs = blk_bs(blk);
+    BlockBackend *rb;
+    int ret = 0;
+
+    if (!erase && blk_getlength(blk) == bytes) {
+        return true;
+    }
+    rb = blk_new_with_bs(bs, BLK_PERM_RESIZE, BLK_PERM_ALL, errp);
+    if (!rb) {
+        return false;
+    }
+    bdrv_drained_begin(bs);
+    if (erase) {
+        ret = blk_truncate(rb, 0, false, PREALLOC_MODE_OFF, 0, errp);
+    }
+    if (ret >= 0) {
+        ret = blk_truncate(rb, bytes, false, PREALLOC_MODE_OFF, 0, errp);
+    }
+    bdrv_drained_end(bs);
+    blk_unref(rb);
+    return ret >= 0;
+}
+
+/*
+ * The LU as a configuration descriptor's parameters for it (@p: a unit's)
+ * have it: its unit descriptor, and its drive at the capacity its
+ * allocation units give (an enhanced memory type's at its capacity
+ * adjustment factor)
+ */
+bool ufs_lu_configure(UfsLu *lu, UfsHc *u, const uint8_t *p, bool erase,
+                      Error **errp)
+{
+    uint64_t au = ufs_alloc_unit_bytes(u);
+    uint64_t units = p[0] ? ldl_be_p(&p[4]) : 0;
+    uint16_t adj = p[3] == 3 ?
+                   be16_to_cpu(u->geometry_desc.enhanced_1_cap_adj_fac) : 256;
+    uint64_t bytes = adj ? QEMU_ALIGN_DOWN(units * au * 256 / adj,
+                                           UFS_BLOCK_SIZE) : 0;
+
+    if (!ufs_lu_resize(lu, bytes, erase, errp)) {
+        return false;
+    }
+    lu->unit_desc.lu_enable = p[0];
+    lu->unit_desc.boot_lun_id = p[1];
+    lu->unit_desc.lu_write_protect = p[2];
+    lu->unit_desc.memory_type = p[3];
+    lu->unit_desc.data_reliability = p[8];
+    lu->unit_desc.logical_block_size = UFS_BLOCK_SIZE_SHIFT;
+    lu->unit_desc.provisioning_type = p[0xa];
+    memcpy(&lu->unit_desc.context_capabilities, &p[0xb], 2);
+    memcpy(&lu->unit_desc.lu_num_write_booster_buffer_alloc_units, &p[0x16],
+           4);
+    lu->unit_desc.logical_block_count =
+        cpu_to_be64(bytes >> UFS_BLOCK_SIZE_SHIFT);
+    return true;
+}
