+static void ufs_config_factory(UfsHc *u)
+{
+    uint8_t *d = u->config;
+    uint64_t au = ufs_alloc_unit_bytes(u);
+    uint64_t bytes =
+        be64_to_cpu(u->geometry_desc.total_raw_device_capacity) <<
+        UFS_GEOMETRY_CAPACITY_SHIFT;
