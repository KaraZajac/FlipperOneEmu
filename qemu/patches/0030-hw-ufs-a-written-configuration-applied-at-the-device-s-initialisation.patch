+    memset(d, 0, UFS_CONFIG_DESC_LEN);
+    d[0] = UFS_CONFIG_DESC_LEN;
+    d[1] = UFS_QUERY_DESC_IDN_CONFIGURATION;
+    d[5] = 0x01;                                /* Active Mode */
+    d[6] = 0x7f;                                /* (no LU first) */
+    for (int i = 0; i < 8; i++) {
+        d[UFS_CONFIG_HDR_LEN + i * UFS_CONFIG_UNIT_LEN + 9] =
+            UFS_BLOCK_SIZE_SHIFT;
+    }
+    d[UFS_CONFIG_HDR_LEN] = 0x01;
+    stl_be_p(&d[UFS_CONFIG_HDR_LEN + 4], au ? bytes / au : 0);
+    u->config_kept = true;
+}
