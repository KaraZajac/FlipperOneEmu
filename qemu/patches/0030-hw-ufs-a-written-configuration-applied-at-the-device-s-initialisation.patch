+/* ... as read: one written reads as written, until fDeviceInit applies it */
+static void ufs_config_desc(UfsHc *u, uint8_t index, uint8_t *d)
+{
+    if (index == 0 && u->config_written) {
+        memcpy(d, u->config_new, UFS_CONFIG_DESC_LEN);
+        return;
+    }
+    ufs_config_now(u, index, d);
+}
