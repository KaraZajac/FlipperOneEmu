+}
+
+/* a configuration's header: the device descriptor's part of it */
+static void ufs_config_header(UfsHc *u, const uint8_t *d)
+{
+    DeviceDescriptor *dd = &u->device_desc;
+
+    dd->boot_enable = d[3];
+    dd->descr_access_en = d[4];
+    dd->init_power_mode = d[5];
+    dd->high_priority_lun = d[6];
+    dd->secure_removal_type = d[7];
+    dd->init_active_icc_level = d[8];
+    memcpy(&dd->periodic_rtc_update, &d[9], 2);
+    dd->write_booster_buffer_preserve_user_space_en = d[0x10];
+    dd->write_booster_buffer_type = d[0x11];
+    memcpy(&dd->num_shared_write_booster_buffer_alloc_units, &d[0x12], 4);
+}
+
+/*
+ * The configuration a device ships with from its maker, before it is
+ * provisioned (the Flipper One's Foresee part reads so): one LU, LU 0,
+ * all of it, normal memory; its boot feature off; no WriteBooster buffer
