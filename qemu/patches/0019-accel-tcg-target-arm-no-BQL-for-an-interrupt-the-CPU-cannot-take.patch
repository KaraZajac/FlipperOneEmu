From: FlipperOneEmu
Subject: [PATCH] accel/tcg, target/arm: no BQL for an interrupt the CPU cannot take

cpu_exec's interrupt check takes the BQL whenever a bit of
interrupt_request is set, to ask the target whether it takes the
interrupt. A level interrupt stays requested while the guest has it
masked, and while it does, the check took the BQL and let it go at each
pass of the loop, for nothing. With Flipper OS booting on the RK3576's
eight Cortex-A cores, that was 12,000 to 43,000 times a second, against
1,200 to 3,000 interrupts taken; and an idle vCPU's busy time went a
quarter on waiting for the BQL.

A target may now say, from the CPU's own state alone and without the
BQL, that none of the requested interrupts can be taken as it is
(cpu_exec_interrupt_masked). Then the check takes no BQL: there is
nothing to do, and an interrupt that comes meanwhile kicks the CPU, so
that the check is made again. Not for EXITTB, HALT, RESET or DEBUG, nor
in record or replay. Arm's A profile answers as arm_cpu_exec_interrupt()
would decide (the target EL from SCR and HCR, the masks in PSTATE), for
FIQ, IRQ, VIRQ, VFIQ, VSERR, and the NMIs as such when FEAT_NMI's
superpriority is off; otherwise it leaves it to the BQL's path. The M
profile's NVIC is the BQL's, and it says nothing.

---
--- a/include/accel/tcg/cpu-ops.h	2026-11-26 08:54:27.317552597 -0500
+++ b/include/accel/tcg/cpu-ops.h	2026-11-26 08:54:27.354964649 -0500
@@ -173,6 +173,14 @@
     void (*do_interrupt)(CPUState *cpu);
     /** @cpu_exec_interrupt: Callback for processing interrupts in cpu_exec */
     bool (*cpu_exec_interrupt)(CPUState *cpu, int interrupt_request);
+    /**
+     * @cpu_exec_interrupt_masked: (optional) true if no interrupt of
+     * @interrupt_request's can be taken in the CPU's present state, as
+     * @cpu_exec_interrupt would find; told from the CPU's own state alone,
+     * without the BQL. Then cpu_exec's check does not take the BQL for
+     * them. False when it cannot tell (a bit it does not know).
+     */
+    bool (*cpu_exec_interrupt_masked)(CPUState *cpu, int interrupt_request);
     /** @cpu_exec_reset: Callback for reset in cpu_exec.  */
     void (*cpu_exec_reset)(CPUState *cpu);
     /**
--- a/accel/tcg/cpu-exec.c	2026-11-26 08:54:27.311306373 -0500
+++ b/accel/tcg/cpu-exec.c	2026-11-26 08:54:27.355226736 -0500
@@ -803,6 +803,23 @@
     assert(!cpu_test_interrupt(cpu, ~0));
 #else
     if (unlikely(cpu_test_interrupt(cpu, ~0))) {
+        const TCGCPUOps *ops = cpu->cc->tcg_ops;
+        int pending = qatomic_read(&cpu->interrupt_request);
+
+        /*
+         * Only interrupts that the CPU cannot take as it is (masked, say):
+         * nothing to do, and no need for the BQL. (Taken for them, it was
+         * taken and let go at each pass of the loop until the guest
+         * unmasked them.) What comes meanwhile kicks the CPU, and the
+         * check is made again.
+         */
+        if (ops->cpu_exec_interrupt_masked &&
+            replay_mode == REPLAY_MODE_NONE &&
+            !(pending & (CPU_INTERRUPT_DEBUG | CPU_INTERRUPT_HALT |
+                         CPU_INTERRUPT_EXITTB | CPU_INTERRUPT_RESET)) &&
+            ops->cpu_exec_interrupt_masked(cpu, pending)) {
+            goto none_to_take;
+        }
         bql_lock();
         if (cpu_test_interrupt(cpu, CPU_INTERRUPT_DEBUG)) {
             cpu_reset_interrupt(cpu, CPU_INTERRUPT_DEBUG);
@@ -870,6 +887,7 @@
         /* If we exit via cpu_loop_exit/longjmp it is reset in cpu_exec */
         bql_unlock();
     }
+none_to_take:
 #endif /* !CONFIG_USER_ONLY */
 
     /*
--- a/target/arm/internals.h	2026-11-26 08:54:27.323853153 -0500
+++ b/target/arm/internals.h	2026-11-26 08:54:27.355486123 -0500
@@ -1309,6 +1309,12 @@
 bool arm_cpu_exec_interrupt(CPUState *cs, int interrupt_request);
 
 /**
+ * arm_cpu_exec_interrupt_masked(): Implementation of the
+ * cpu_exec_interrupt_masked hook.
+ */
+bool arm_cpu_exec_interrupt_masked(CPUState *cs, int interrupt_request);
+
+/**
  * arm_cpu_update_virq: Update CPU_INTERRUPT_VIRQ bit in cs->interrupt_request
  *
  * Update the CPU_INTERRUPT_VIRQ bit in cs->interrupt_request, following
--- a/target/arm/cpu-irq.c	2026-11-26 08:54:27.330448543 -0500
+++ b/target/arm/cpu-irq.c	2026-11-26 08:54:27.355638675 -0500
@@ -169,6 +169,65 @@
     return unmasked || pstate_unmasked;
 }
 
+/*
+ * No interrupt of @interrupt_request's can be taken in the CPU's present
+ * state: what arm_cpu_exec_interrupt() would find, from the CPU's own
+ * registers alone, without the BQL. False for a bit it does not know, and
+ * with FEAT_NMI's superpriority in use (left to arm_cpu_exec_interrupt()).
+ */
+bool arm_cpu_exec_interrupt_masked(CPUState *cs, int interrupt_request)
+{
+    static const struct {
+        int bit;
+        uint32_t excp_idx;
+    } kinds[] = {
+        { CPU_INTERRUPT_FIQ, EXCP_FIQ }, { CPU_INTERRUPT_HARD, EXCP_IRQ },
+        { CPU_INTERRUPT_VIRQ, EXCP_VIRQ }, { CPU_INTERRUPT_VFIQ, EXCP_VFIQ },
+        { CPU_INTERRUPT_VSERR, EXCP_VSERR },
+    };
+    const int known = CPU_INTERRUPT_FIQ | CPU_INTERRUPT_HARD |
+                      CPU_INTERRUPT_VIRQ | CPU_INTERRUPT_VFIQ |
+                      CPU_INTERRUPT_VSERR | CPU_INTERRUPT_NMI |
+                      CPU_INTERRUPT_VINMI | CPU_INTERRUPT_VFNMI;
+    CPUARMState *env = cpu_env(cs);
+    uint32_t cur_el = arm_current_el(env);
+    bool secure = arm_is_secure(env);
+    uint64_t hcr_el2 = arm_hcr_el2_eff(env);
+
+    if (interrupt_request & ~known) {
+        return false;
+    }
+    if (cpu_isar_feature(aa64_nmi, env_archcpu(env)) &&
+        (arm_sctlr(env, cur_el) & SCTLR_NMI)) {
+        return false;
+    }
+    /* NMI disabled: those with superpriority are taken as without it */
+    if (interrupt_request & CPU_INTERRUPT_NMI) {
+        interrupt_request |= CPU_INTERRUPT_HARD;
+    }
+    if (interrupt_request & CPU_INTERRUPT_VINMI) {
+        interrupt_request |= CPU_INTERRUPT_VIRQ;
+    }
+    if (interrupt_request & CPU_INTERRUPT_VFNMI) {
+        interrupt_request |= CPU_INTERRUPT_VFIQ;
+    }
+    for (int i = 0; i < ARRAY_SIZE(kinds); i++) {
+        uint32_t excp_idx = kinds[i].excp_idx;
+        uint32_t target_el;
+
+        if (!(interrupt_request & kinds[i].bit)) {
+            continue;
+        }
+        target_el = excp_idx == EXCP_FIQ || excp_idx == EXCP_IRQ ?
+                    arm_phys_excp_target_el(cs, excp_idx, cur_el, secure) : 1;
+        if (arm_excp_unmasked(cs, excp_idx, target_el, cur_el, secure,
+                              hcr_el2)) {
+            return false;
+        }
+    }
+    return true;
+}
+
 bool arm_cpu_exec_interrupt(CPUState *cs, int interrupt_request)
 {
     CPUARMState *env = cpu_env(cs);
--- a/target/arm/cpu.c	2026-11-26 08:54:27.336903345 -0500
+++ b/target/arm/cpu.c	2026-11-26 08:54:27.355896992 -0500
@@ -2615,6 +2615,7 @@
     .tlb_fill_align = arm_cpu_tlb_fill_align,
     .pointer_wrap = aprofile_pointer_wrap,
     .cpu_exec_interrupt = arm_cpu_exec_interrupt,
+    .cpu_exec_interrupt_masked = arm_cpu_exec_interrupt_masked,
     .cpu_exec_halt = arm_cpu_exec_halt,
     .cpu_exec_reset = cpu_reset,
     .do_interrupt = arm_cpu_do_interrupt,
