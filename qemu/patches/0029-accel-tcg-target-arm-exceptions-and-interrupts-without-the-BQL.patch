+        if (!unlocked) {
+            bql_lock();
+        }
         tcg_ops->do_interrupt(cpu);
-        bql_unlock();
+        if (!unlocked) {
+            bql_unlock();
+        }
         cpu->exception_index = -1;
 
         if (unlikely(cpu_single_stepping(cpu))) {
@@ -831,6 +839,37 @@
             ops->cpu_exec_interrupt_masked(cpu, pending)) {
             goto none_to_take;
         }
+        /*
+         * Only EXITTB, which a target's do_interrupt sets after it has
+         * taken an exception: no chaining across it, and no need for the
+         * BQL to clear it.
+         */
+        if (pending == CPU_INTERRUPT_EXITTB &&
+            replay_mode == REPLAY_MODE_NONE) {
+            cpu_reset_interrupt(cpu, CPU_INTERRUPT_EXITTB);
+            *last_tb = NULL;
+            goto none_to_take;
+        }
+        /*
+         * Interrupts that the target takes without the BQL
+         * (cpu_exec_interrupt_unlocked): as below, without it.
+         */
+        if (ops->cpu_exec_interrupt_unlocked &&
+            replay_mode == REPLAY_MODE_NONE && !cpu_single_stepping(cpu) &&
+            !(pending & (CPU_INTERRUPT_DEBUG | CPU_INTERRUPT_HALT |
+                         CPU_INTERRUPT_RESET)) &&
+            ops->cpu_exec_interrupt_unlocked(cpu,
+                                             pending & ~CPU_INTERRUPT_EXITTB)) {
+            if (ops->cpu_exec_interrupt(cpu, pending)) {
+                cpu->exception_index = -1;
+                *last_tb = NULL;
+            }
+            if (cpu_test_interrupt(cpu, CPU_INTERRUPT_EXITTB)) {
+                cpu_reset_interrupt(cpu, CPU_INTERRUPT_EXITTB);
+                *last_tb = NULL;
+            }
+            goto none_to_take;
+        }
         bql_lock();
         if (cpu_test_interrupt(cpu, CPU_INTERRUPT_DEBUG)) {
             cpu_reset_interrupt(cpu, CPU_INTERRUPT_DEBUG);
--- a/target/arm/internals.h	2026-11-27 18:51:17.036055236 -0500
+++ b/target/arm/internals.h	2026-11-27 18:51:55.934772990 -0500
@@ -1315,6 +1315,14 @@
 bool arm_cpu_exec_interrupt_masked(CPUState *cs, int interrupt_request);
 
 /**
+ * arm_cpu_exec_interrupt_unlocked(), arm_cpu_do_interrupt_unlocked():
+ * Implementations of the cpu_exec_interrupt_unlocked and
+ * do_interrupt_unlocked hooks.
+ */
+bool arm_cpu_exec_interrupt_unlocked(CPUState *cs, int interrupt_request);
+bool arm_cpu_do_interrupt_unlocked(CPUState *cs);
+
+/**
  * arm_cpu_update_virq: Update CPU_INTERRUPT_VIRQ bit in cs->interrupt_request
  *
  * Update the CPU_INTERRUPT_VIRQ bit in cs->interrupt_request, following
--- a/target/arm/cpu-irq.c	2026-11-27 18:51:17.042314164 -0500
+++ b/target/arm/cpu-irq.c	2026-11-27 18:51:55.934935758 -0500
@@ -228,6 +228,45 @@
     return true;
 }
 
+/*
+ * What arm_cpu_do_interrupt() takes as a change of the CPU's own state
+ * alone, without the BQL: on an A profile CPU without a GICv3 CPU
+ * interface (whose registers are the GIC's), when the EL change hooks have
+ * nothing to do (the PMU's, none of its counters enabled), the exceptions
+ * a guest raises all the time (a system call, an abort, an undefined
+ * instruction) and the physical IRQ and FIQ. Not PSCI's HVC or SMC,
+ * semihosting or debug: those are the BQL's.
+ */
+bool arm_cpu_do_interrupt_unlocked(CPUState *cs)
+{
+    ARMCPU *cpu = ARM_CPU(cs);
+
+    switch (cs->exception_index) {
+    case EXCP_UDEF:
+    case EXCP_SWI:
+    case EXCP_PREFETCH_ABORT:
+    case EXCP_DATA_ABORT:
+    case EXCP_IRQ:
+    case EXCP_FIQ:
+        break;
+    default:
+        return false;
+    }
+    return !arm_feature(&cpu->env, ARM_FEATURE_M) && !cpu->env.gicv3state &&
+           arm_el_change_hooks_idle(cpu);
+}
+
+/* ... and so arm_cpu_exec_interrupt() for a physical IRQ or FIQ alone */
+bool arm_cpu_exec_interrupt_unlocked(CPUState *cs, int interrupt_request)
+{
+    ARMCPU *cpu = ARM_CPU(cs);
+
+    return interrupt_request &&
+           !(interrupt_request & ~(CPU_INTERRUPT_HARD | CPU_INTERRUPT_FIQ)) &&
+           !arm_feature(&cpu->env, ARM_FEATURE_M) && !cpu->env.gicv3state &&
+           arm_el_change_hooks_idle(cpu);
+}
+
 bool arm_cpu_exec_interrupt(CPUState *cs, int interrupt_request)
 {
     CPUARMState *env = cpu_env(cs);
