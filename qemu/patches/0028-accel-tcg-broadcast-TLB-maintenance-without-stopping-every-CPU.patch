     d.bits = bits;
 
+    if (len && tlb_shootdown(src_cpu, d.addr, d.len, d.idxmap, d.bits)) {
+        return;
+    }
     /* Allocate a separate data block for each destination cpu.  */
     CPU_FOREACH(dst_cpu) {
         if (dst_cpu != src_cpu) {
--- a/accel/tcg/cpu-exec.c	2026-11-27 16:49:52.922758762 -0500
