+/*
+ * Broadcast maintenance without stopping every CPU.
+ *
+ * A broadcast flush (an Arm TLBI ...IS) must be complete on every CPU
+ * that shares the source's translations once the source goes on.  The
+ * synced functions below do that with an exclusive section: the source
+ * leaves its execution loop, every other CPU is kicked out of its own,
+ * those halted are woken (each taking the BQL to process its work), and
+ * all wait until the source has flushed itself.  Linux on an ARMv8.0 core
+ * issues one such flush at each copy-on-write fault and at each first
+ * write to a clean page, hundreds for each process it starts.
+ *
+ * Instead the source flushes itself, asks the same flush of each other CPU
+ * on its memory (tlb_shootdown_post), and waits only for those running
+ * guest code: they break out of their TB chains and do it between two TBs
+ * (cpu_handle_interrupt), without leaving cpu_exec or taking the BQL.  A
+ * CPU not running guest code does it before it next runs some
+ * (tcg_cpu_exec, cpu_exec_step_atomic): it is neither woken nor waited
+ * for.  While the source waits it does what is asked of itself, so that
+ * two sources never wait for each other.  Should a CPU not answer soon
+ * (blocked for the BQL, say, or its thread not scheduled), the source
+ * falls back to the exclusive section, which waits for that CPU to leave
+ * cpu_exec; and before it runs guest code again it does what was asked.
+ */
+
+#define TLB_SHOOTDOWN_SPIN_NS   (50 * SCALE_US)
+
+/* (CPUs on other memory, another SoC's cores, share no translations) */
+static bool tlb_shootdown_peer(CPUState *a, CPUState *b)
+{
+    AddressSpace *x, *y;
+
+    if (!a->cpu_ases || !b->cpu_ases) {
+        return true;
+    }
+    x = cpu_get_address_space(a, 0);
+    y = cpu_get_address_space(b, 0);
+    return !x || !y || x->root == y->root;
+}
+
+/* @d on @cpu: a whole flush (bits below a page's), a page's (len 0), or a
+ * range's */
+static void tlb_shootdown_do(CPUState *cpu, const TLBFlushRangeData *d)
+{
+    if (d->bits < TARGET_PAGE_BITS) {
+        tlb_flush_by_mmuidx_async_work(cpu, RUN_ON_CPU_HOST_INT(d->idxmap));
+    } else if (d->len == 0) {
+        tlb_flush_page_by_mmuidx_async_0(cpu, d->addr, d->idxmap);
+    } else {
+        tlb_flush_range_by_mmuidx_async_0(cpu, *d);
+    }
+}
+
+/* ask @d of @cpu: its request's number */
+static uint64_t tlb_shootdown_post(CPUState *cpu, const TLBFlushRangeData *d)
+{
+    CPUTLBCommon *c = &cpu->neg.tlb.c;
+    uint64_t gen;
+
+    qemu_spin_lock(&c->req_lock);
+    if (d->bits < TARGET_PAGE_BITS || c->req_n == ARRAY_SIZE(c->req)) {
+        c->req_full |= d->idxmap;
+    } else {
+        c->req[c->req_n].addr = d->addr;
+        c->req[c->req_n].len = d->len;
+        c->req[c->req_n].idxmap = d->idxmap;
+        c->req[c->req_n].bits = d->bits;
+        c->req_n++;
+    }
+    gen = ++c->req_gen;
+    qatomic_set(&c->req_pending, true);
+    qemu_spin_unlock(&c->req_lock);
+    return gen;
+}
+
+void tlb_shootdown_process(CPUState *cpu)
+{
+    CPUTLBCommon *c = &cpu->neg.tlb.c;
+    TLBFlushRangeData d[ARRAY_SIZE(c->req)];
+    MMUIdxMap full;
+    uint32_t n;
+    uint64_t gen;
+
+    if (!qatomic_read(&c->req_pending)) {
+        return;
+    }
+    qemu_spin_lock(&c->req_lock);
+    n = c->req_n;
+    for (uint32_t i = 0; i < n; i++) {
+        d[i].addr = c->req[i].addr;
+        d[i].len = c->req[i].len;
+        d[i].idxmap = c->req[i].idxmap;
+        d[i].bits = c->req[i].bits;
+    }
+    full = c->req_full;
+    c->req_n = 0;
+    c->req_full = 0;
+    gen = c->req_gen;
+    qatomic_set(&c->req_pending, false);
+    qemu_spin_unlock(&c->req_lock);
+
+    if (full) {
+        tlb_flush_by_mmuidx_async_work(cpu, RUN_ON_CPU_HOST_INT(full));
+    }
+    for (uint32_t i = 0; i < n; i++) {
+        if (d[i].idxmap & ~full) {
+            tlb_shootdown_do(cpu, &d[i]);
+        }
+    }
+    qatomic_store_release(&c->req_done, gen);
+}
+
+static void tlb_shootdown_fallback(CPUState *cpu, run_on_cpu_data data)
+{
+    /* (the exclusive section itself is the point) */
+}
+
+/* a flush broadcast from @src, as above (as tlb_shootdown_do's: whole,
+ * page or range): false if it is not for this way (not from the source's
+ * own thread, inside cpu_exec) */
+static bool tlb_shootdown(CPUState *src, vaddr addr, vaddr len,
+                          MMUIdxMap idxmap, unsigned bits)
+{
+    TLBFlushRangeData d = {
+        .addr = addr, .len = len, .idxmap = idxmap, .bits = bits
+    };
+    struct {
+        CPUState *cpu;
+        uint64_t gen;
+    } wait[64];
+    bool fallback = false;
+    int64_t deadline = 0;
+    CPUState *cpu;
+    int n = 0;
+
+    if (current_cpu != src || !qatomic_read(&src->running)) {
+        return false;
+    }
+    CPU_FOREACH(cpu) {
+        uint64_t gen;
+
+        if (cpu == src || !tlb_shootdown_peer(src, cpu)) {
+            continue;
+        }
+        gen = tlb_shootdown_post(cpu, &d);
+        smp_mb();                       /* (asked, then is it running?) */
+        if (!qatomic_read(&cpu->running)) {
+            continue;                   /* (it does it before it runs) */
+        }
+        qatomic_store_release(&cpu->neg.icount_decr.u16.high, -1);
+        if (n < ARRAY_SIZE(wait)) {
+            wait[n].cpu = cpu;
+            wait[n].gen = gen;
+            n++;
+        } else {
+            fallback = true;
+        }
+    }
+    tlb_shootdown_do(src, &d);
+    for (int i = 0; i < n && !fallback; i++) {
+        CPUTLBCommon *c = &wait[i].cpu->neg.tlb.c;
+
+        while (qatomic_load_acquire(&c->req_done) < wait[i].gen &&
+               qatomic_read(&wait[i].cpu->running)) {
+            tlb_shootdown_process(src);
+            if (!deadline) {
+                deadline = get_clock() + TLB_SHOOTDOWN_SPIN_NS;
+            } else if (get_clock() > deadline) {
+                fallback = true;
+                break;
+            }
+            cpu_relax();
+        }
+    }
+    if (fallback) {
+        async_safe_run_on_cpu(src, tlb_shootdown_fallback, RUN_ON_CPU_NULL);
+    }
+    return true;
+}
+
 void tlb_flush_range_by_mmuidx(CPUState *cpu, vaddr addr,
                                vaddr len, MMUIdxMap idxmap,
                                unsigned bits)
@@ -830,6 +1021,9 @@
