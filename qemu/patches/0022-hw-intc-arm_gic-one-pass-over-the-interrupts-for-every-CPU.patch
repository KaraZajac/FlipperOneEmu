From: FlipperOneEmu
Subject: [PATCH] hw/intc/arm_gic: one pass over the interrupts for every CPU

An update of the GIC (made for each change of an interrupt line, each
write to the distributor, each acknowledge and end of an interrupt)
looked for each CPU's best pending interrupt with a pass over every
interrupt per CPU: on the RK3576's GIC-400, 480 interrupts for 8 CPUs,
with the BQL held. While Flipper OS boots, the update was the GIC's
most frequent place in stack samples, from the distributor and from the
CPU interface.

An interrupt's state is kept per CPU as bit masks, so the CPUs that it
is a candidate for (enabled, pending, not active, targeted) come from a
few operations on them at once. Now one pass over the interrupts finds
every CPU's best; the lowest numbered of a CPU's best priority still
wins, and the group is that interrupt's for the CPU, as before.

---
--- a/hw/intc/arm_gic.c	2026-11-26 09:48:40.140039284 -0500
+++ b/hw/intc/arm_gic.c	2026-11-26 09:48:40.159398467 -0500
@@ -82,28 +82,45 @@
     return !gic_is_vcpu(cpu) && s->security_extn && !attrs.secure;
 }
 
-static inline void gic_get_best_irq(GICState *s, int cpu,
-                                    int *best_irq, int *best_prio, int *group)
+/*
+ * The best pending interrupt of every CPU, in one pass over the interrupts:
+ * an interrupt's state is per CPU as bit masks, so the CPUs it is a
+ * candidate for (enabled, pending, not active, targeted) come at once.
+ * The lowest numbered of a CPU's best priority wins, as when it was a pass
+ * for each CPU (an update made num_cpu of them, over every interrupt).
+ */
+static inline void gic_get_best_irqs(GICState *s, int *best_irq,
+                                     int *best_prio)
 {
-    int irq;
-    int cm = 1 << cpu;
-
-    *best_irq = 1023;
-    *best_prio = 0x100;
+    unsigned all = (1u << s->num_cpu) - 1;
+    int cpu, irq;
 
+    for (cpu = 0; cpu < s->num_cpu; cpu++) {
+        best_irq[cpu] = 1023;
+        best_prio[cpu] = 0x100;
+    }
     for (irq = 0; irq < s->num_irq; irq++) {
-        if (GIC_DIST_TEST_ENABLED(irq, cm) && gic_test_pending(s, irq, cm) &&
-            (!GIC_DIST_TEST_ACTIVE(irq, cm)) &&
-            (irq < GIC_INTERNAL || GIC_DIST_TARGET(irq) & cm)) {
-            if (GIC_DIST_GET_PRIORITY(irq, cpu) < *best_prio) {
-                *best_prio = GIC_DIST_GET_PRIORITY(irq, cpu);
-                *best_irq = irq;
-            }
+        gic_irq_state *st = &s->irq_state[irq];
+        unsigned pending = st->pending;
+        unsigned cand;
+
+        if (s->revision != REV_11MPCORE && !st->edge_trigger) {
+            pending |= st->level;       /* (as gic_test_pending() has it) */
         }
-    }
+        cand = st->enabled & pending & ~st->active & all;
+        if (irq >= GIC_INTERNAL) {
+            cand &= GIC_DIST_TARGET(irq);
+        }
+        for (; cand; cand &= cand - 1) {
+            int prio;
 
-    if (*best_irq < 1023) {
-        *group = GIC_DIST_TEST_GROUP(*best_irq, cm);
+            cpu = ctz32(cand);
+            prio = GIC_DIST_GET_PRIORITY(irq, cpu);
+            if (prio < best_prio[cpu]) {
+                best_prio[cpu] = prio;
+                best_irq[cpu] = irq;
+            }
+        }
     }
 }
 
@@ -163,6 +180,7 @@
 /* Update interrupt status after enabled or pending bits have been changed.  */
 static inline void gic_update_internal(GICState *s, bool virt)
 {
+    int best_irqs[GIC_NCPU], best_prios[GIC_NCPU];
     int best_irq;
     int best_prio;
     int irq_level, fiq_level;
@@ -171,6 +189,9 @@
     qemu_irq *irq_lines = virt ? s->parent_virq : s->parent_irq;
     qemu_irq *fiq_lines = virt ? s->parent_vfiq : s->parent_fiq;
 
+    if (!virt) {
+        gic_get_best_irqs(s, best_irqs, best_prios);
+    }
     for (cpu = 0; cpu < s->num_cpu; cpu++) {
         cpu_iface = virt ? (cpu + GIC_NCPU) : cpu;
 
@@ -185,7 +206,11 @@
         if (virt) {
             gic_get_best_virq(s, cpu, &best_irq, &best_prio, &group);
         } else {
-            gic_get_best_irq(s, cpu, &best_irq, &best_prio, &group);
+            best_irq = best_irqs[cpu];
+            best_prio = best_prios[cpu];
+            if (best_irq < 1023) {
+                group = GIC_DIST_TEST_GROUP(best_irq, 1 << cpu);
+            }
         }
 
         if (best_irq != 1023) {
