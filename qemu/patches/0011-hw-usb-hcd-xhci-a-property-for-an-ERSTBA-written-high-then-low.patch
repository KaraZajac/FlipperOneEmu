From: FlipperOneEmu
Subject: [PATCH] hw/usb/hcd-xhci: a property for an ERSTBA written high then low

The xHCI specification has 64-bit registers written as two dwords low
first, and QEMU loads an interrupter's event ring segment table when
ERSTBA's high dword is written. Synopsys DWC3's xHCI loads it on the low
dword, and Linux's dwc3 host gives xhci-plat its write-64-hi-lo quirk,
writing the high dword first. QEMU then loads the table from the new
high half and the old low half (0 after a reset), and the first event
written to the ring kills the controller ("ERDP out of bounds", HCE).

Add "erstba-hi-lo" (default off): with it, the low dword's write loads
the table and the high dword's only keeps its value, as on DWC3.

---
--- a/hw/usb/hcd-xhci.h
+++ b/hw/usb/hcd-xhci.h
@@ -37,6 +37,8 @@
 
 enum xhci_flags {
     XHCI_FLAG_ENABLE_STREAMS = 1,
+    /* ERSTBA takes effect on the write of its low dword, not its high one */
+    XHCI_FLAG_ERSTBA_HI_LO,
 };
 
 typedef enum TRBType {
--- a/hw/usb/hcd-xhci.c
+++ b/hw/usb/hcd-xhci.c
@@ -3131,10 +3131,15 @@
         } else {
             intr->erstba_low = val & 0xffffffc0;
         }
+        if (xhci_get_flag(xhci, XHCI_FLAG_ERSTBA_HI_LO)) {
+            xhci_er_reset(xhci, v);
+        }
         break;
     case 0x14: /* ERSTBA high */
         intr->erstba_high = val;
-        xhci_er_reset(xhci, v);
+        if (!xhci_get_flag(xhci, XHCI_FLAG_ERSTBA_HI_LO)) {
+            xhci_er_reset(xhci, v);
+        }
         break;
     case 0x18: /* ERDP low */
         if (val & ERDP_EHB) {
@@ -3683,6 +3688,14 @@
 static const Property xhci_properties[] = {
     DEFINE_PROP_BIT("streams", XHCIState, flags,
                     XHCI_FLAG_ENABLE_STREAMS, true),
+    /*
+     * A host whose ERSTBA is loaded by its low dword, written last, as
+     * Synopsys DWC3's (Linux then writes the high dword first: its
+     * XHCI_WRITE_64_HI_LO quirk); the xHCI specification has it the other
+     * way round, which is the default
+     */
+    DEFINE_PROP_BIT("erstba-hi-lo", XHCIState, flags,
+                    XHCI_FLAG_ERSTBA_HI_LO, false),
     DEFINE_PROP_UINT32("p2",    XHCIState, numports_2, 4),
     DEFINE_PROP_UINT32("p3",    XHCIState, numports_3, 4),
     DEFINE_PROP_LINK("host",    XHCIState, hostOpaque, TYPE_DEVICE,
