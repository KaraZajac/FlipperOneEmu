  'rp2350_qmi.c',
  'rp2350_timer.c',
  'rp2350_gpio.c',
  'rp2350_pio.c',
  'rp2350_ppb.c',
  'rp2350_dma.c',
  'rp2350_hstx.c',
  'rp2350_pwm.c',
  'jd9853.c',
  'rp2350_i2c.c',
  'pcal6416.c',
))
